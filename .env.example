# Local environment template. Real values stay out of the repository; never
# commit credentials here.
# Synthetic model access:
SYNTHETIC_API_KEY=
KNOWLEDGE_AI_PROVIDER=zai
# Leave empty to use the selected provider's default base URL.
KNOWLEDGE_AI_BASE_URL=

# Optional Ollama credentials remain available for /ask or for switching the
# enrichment provider back to Ollama.
OLLAMA_API_KEY=
OLLAMA_COOKIE_HEADER='wos-session=replace-me'
ALIBABA_API_KEY=
# DASHSCOPE_API_KEY is also accepted for Alibaba Model Studio credentials.
DASHSCOPE_API_KEY=
ALIBABA_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
HF_TOKEN=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
OPENCODE_GO_API_KEY=

# GLM Coding Plan (Z.AI): OpenAI-compatible coding endpoint used for
# enrichment. Get a key under Individual Coding Plan > Plan Overview.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Boot defaults for the browser-editable AI settings. Once saved from the
# Settings page, the database values take priority; keys remain here only.
# Hugging Face is intentionally omitted for now; add it here to re-enable it.
KNOWLEDGE_CHAT_PROVIDERS=alibaba,synthetic,ollama,opencode-go
KNOWLEDGE_CHAT_DEFAULT_MODEL=qwen3.8-flash
KNOWLEDGE_CHAT_MODELS=syn:large:text,syn:small:text,glm-5.2,hf:zai-org/GLM-5.3-Flash,qwen3.8-flash,deepseek-v4-flash-0731,kimi-k2.6,kimi-k3,deepseek-v4-flash
KNOWLEDGE_SYNTHETIC_CHAT_MODEL=syn:large:text
KNOWLEDGE_OLLAMA_CHAT_MODEL=glm-5.2
OPENCODE_GO_MODEL=glm-5.2

KNOWLEDGE_AI_MODEL=glm-5.3-flash
# Hugging Face is intentionally omitted for now; add it here to re-enable it.
# Alibaba Cloud is disabled (not removed): re-add "alibaba" to the order and
# keep ALIBABA_API_KEY/DASHSCOPE_API_KEY to re-enable it.
KNOWLEDGE_AI_PROVIDER_ORDER=zai,synthetic,ollama
# Synthetic's syn:large:text alias supports both text and vision jobs.
KNOWLEDGE_SYNTHETIC_ENRICHMENT_MODEL=syn:large:text
KNOWLEDGE_ALIBABA_ENRICHMENT_MODEL=qwen3.8-flash
KNOWLEDGE_ALIBABA_CHAT_MODEL=qwen3.8-flash
KNOWLEDGE_ZAI_ENRICHMENT_MODEL=glm-5.3-flash
KNOWLEDGE_HUGGINGFACE_MODEL=zai-org/GLM-5.3-Flash
# Optional dedicated page stream: this provider gets its own pool slots that
# run in parallel to the primary chain. Synthetic's pack allows one request
# per model, so keep the concurrency at 1. Empty disables the stream.
KNOWLEDGE_AI_PAGE_PARALLEL_PROVIDER=synthetic
KNOWLEDGE_AI_PAGE_PARALLEL_CONCURRENCY=1
# AI lanes (document synthesis, course blueprints, practice) claim jobs
# concurrently; 1 restores the legacy one-at-a-time behavior.
KNOWLEDGE_AI_LANE_CONCURRENCY=3
# Per-file guides retry on the next model when the primary one cannot produce
# a valid guide. Direct enrichment may attach images, so keep these multimodal.
KNOWLEDGE_AI_DOCUMENT_FALLBACK_MODELS=
KNOWLEDGE_AI_ANALYSIS_VERSION=6
KNOWLEDGE_AI_QUOTA_ENABLED=false
# These quota settings apply only when KNOWLEDGE_AI_PROVIDER=ollama.
KNOWLEDGE_AI_QUOTA_SESSION_LIMIT_PERCENT=95
KNOWLEDGE_AI_QUOTA_WEEKLY_LIMIT_PERCENT=100
KNOWLEDGE_AI_QUOTA_POLL_SECONDS=60
KNOWLEDGE_AI_QUOTA_MAX_REQUESTS_BETWEEN_CHECKS=20
KNOWLEDGE_AI_QUOTA_RESET_GRACE_SECONDS=30

# A separate frontier model periodically synthesizes evidence-backed,
# course-wide blueprints. Ordinary progress updates use the local scheduler.
# Sends a bounded cross-source packet (including selected Discord excerpts) to
# the configured AI provider. Enable only after approving that transfer.
KNOWLEDGE_AI_COURSE_SYNTHESIS_ENABLED=false
KNOWLEDGE_AI_COURSE_MODEL=glm-5.3
KNOWLEDGE_AI_COURSE_FALLBACK_MODELS=glm-5.3-flash
KNOWLEDGE_AI_COURSE_ANALYSIS_VERSION=4
KNOWLEDGE_AI_COURSE_MAX_INPUT_CHARS=140000
KNOWLEDGE_AI_COURSE_DISCORD_LIMIT=48

# Only index courses that have an enabled exam plan. Extraction runs inline
# on the worker's scheduler thread, so files from courses you are not
# sitting an exam for otherwise stall every AI lane behind them. Already
# indexed documents are never removed by this.
KNOWLEDGE_INDEX_PLANNED_COURSES_ONLY=true

# Active recall. Each roadmap unit gets practice questions written only from
# the evidence that unit already cites, so nothing new leaves the machine that
# course synthesis did not already send. Requires
# KNOWLEDGE_AI_COURSE_SYNTHESIS_ENABLED.
# Attempt history is kept in eclass.db and survives every regeneration.
KNOWLEDGE_AI_PRACTICE_ENABLED=false
KNOWLEDGE_AI_PRACTICE_MODEL=glm-5.3
KNOWLEDGE_AI_PRACTICE_FALLBACK_MODELS=glm-5.3-flash
KNOWLEDGE_AI_PRACTICE_ANALYSIS_VERSION=1
KNOWLEDGE_AI_PRACTICE_MAX_INPUT_CHARS=90000
KNOWLEDGE_AI_PRACTICE_TARGET_QUESTIONS=8
KNOWLEDGE_AI_PRACTICE_MAX_QUESTIONS=12
KNOWLEDGE_AI_PRACTICE_MAX_UNITS=40

# One Synthetic subscription pack allows one concurrent request per model.
# Increase this only when the account has additional per-model capacity.
KNOWLEDGE_AI_PAGE_CONCURRENCY=1
KNOWLEDGE_AI_PAGE_ANALYSIS_VERSION=2
KNOWLEDGE_AI_PAGE_FALLBACK_MODELS=
KNOWLEDGE_AI_PAGE_ATTEMPTS_PER_MODEL=3

# The API writes maintenance requests here; the background process consumes them.
BACKGROUND_CONTROL_FILE=/data/background-control.json

# Discord is an optional eClass messages module. Existing archive channels can
# be mapped to courses by name directly from the Settings page.
DISCORD_KNOWLEDGE_ENABLED=true
DISCORD_KNOWLEDGE_WORKER_ENABLED=true
DISCORD_KNOWLEDGE_POLL_SECONDS=300
DISCORD_KNOWLEDGE_VERIFY_HASHES=true
DISCORD_POLICY_HALF_LIFE_DAYS=180
DISCORD_GENERAL_HALF_LIFE_DAYS=730

# Configure the integrated exporter from Settings → Discord Exporter.
